{
  "name": "inkprint",
  "version": "0.0.0",
  "private": true,
  "description": "Inkprint — writing-process platform for educators.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell \"**/*.md\" \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.10",
    "cspell": "^8.15.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
