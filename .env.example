# Inkprint — environment variables (template)
# Copy to .env and fill in. Never commit .env.

# ─── Postgres ─────────────────────────────────────────────────────────────────
# Neon:  postgres://USER:PASS@HOST/DB?sslmode=require
# Local: postgres://localhost:5432/inkprint_dev
DATABASE_URL=
# App role (provisioned by `pnpm --filter @inkprint/db setup-app-role`).
APP_DATABASE_URL=

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ─── Email (Resend) — Step 7 ──────────────────────────────────────────────────
RESEND_API_KEY=

# ─── KMS / encryption — Step 9 (BYOK) ─────────────────────────────────────────
KMS_KEY_ID=
KMS_REGION=us-east-1

# ─── LLM providers — Step 9+ (worker only) ────────────────────────────────────
POOLED_OPENAI_KEY=
POOLED_ANTHROPIC_KEY=
POOLED_GEMINI_KEY=

# ─── Observability — Step 14 ──────────────────────────────────────────────────
POSTHOG_KEY=
SENTRY_DSN=
